<Window x:Class="_04._10.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_04._10"
        mc:Ignorable="d"
        Title="Переключатели" Height="400" Width="600">

    <Window.Resources>
        <Style TargetType="Grid" x:Key="SwitchStyle">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform/>
                        <RotateTransform/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation To="1.2" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX" Duration="0"/>
                        </Storyboard>
                    </BeginStoryboard>

                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation To="1.2" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY" Duration="0"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation To="1" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX" Duration="0"/>
                        </Storyboard>
                    </BeginStoryboard>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation To="1" Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY" Duration="0"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeftButtonDown">
                    <BeginStoryboard HandoffBehavior="Compose">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Children[1].Angle" Duration="0:0:0.3" By="20"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>

            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!--1 переключатель -->
        <Viewbox Grid.Column="0" >
            <Grid RenderTransformOrigin="0.5,0.5"  Style="{StaticResource SwitchStyle}">
                <Polygon Name="Polygon1"
                         Points="70,180 100,160 130,180 130,210 100,230 70,210"
                         Stroke="Gray"
                         StrokeThickness="2">
                    <Polygon.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Opacity="1">
                            <GradientStop Color="White" Offset="0" />
                            <GradientStop Color="LightGray" Offset="1" />
                        </RadialGradientBrush>
                    </Polygon.Fill>
                </Polygon>

                <Ellipse Width="25" Height="25"
                         Fill="#FFAFAFAF"
                         Stroke="Gray"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />

                <Rectangle Width="40" Height="10"
                           Fill="LightGreen"
                           Stroke="Green"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <Rectangle Width="6" Height="2"
                           Fill="Brown" Margin="81,191,113,191" />
            </Grid>
        </Viewbox>

        <!--2 переключатель -->
        <Viewbox Grid.Column="1" >
            <Grid RenderTransformOrigin="0.5,0.5" Style="{StaticResource SwitchStyle}">
                <Polygon Name="Polygon2"
                         Points="70,180 100,160 130,180 130,210 100,230 70,210"
                         Stroke="Gray"
                         StrokeThickness="2">
                    <Polygon.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.5">
                            <GradientStop Color="White" Offset="0" />
                            <GradientStop Color="LightGray" Offset="1" />
                        </RadialGradientBrush>
                    </Polygon.Fill>
                    <Polygon.RenderTransform>
                        <RotateTransform x:Name="RotateTransform2" CenterX="100" CenterY="195"/>
                    </Polygon.RenderTransform>
                </Polygon>

                <Ellipse Width="25" Height="25"
                         Fill="#FFAFAFAF"
                         Stroke="Gray"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />

                <Rectangle Width="40" Height="10"
                           Fill="LightGreen"
                           Stroke="Green"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <Rectangle Width="6" Height="2"
                           Fill="Brown" Margin="81,191,113,191" />
            </Grid>
        </Viewbox>

        <!--3 переключатель -->
        <Viewbox Grid.Column="2">
            <Grid RenderTransformOrigin="0.5,0.5" Style="{StaticResource SwitchStyle}">
                <Polygon Name="Polygon3"
                         Points="70,180 100,160 130,180 130,210 100,230 70,210"
                         Stroke="Gray"
                         StrokeThickness="2">
                    <Polygon.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.5">
                            <GradientStop Color="White" Offset="0" />
                            <GradientStop Color="LightGray" Offset="1" />
                        </RadialGradientBrush>
                    </Polygon.Fill>
                    <Polygon.RenderTransform>
                        <RotateTransform x:Name="RotateTransform3" CenterX="100" CenterY="195"/>
                    </Polygon.RenderTransform>
                </Polygon>

                <Ellipse Width="25" Height="25"
                         Fill="#FFAFAFAF"
                         Stroke="Gray"
                         StrokeThickness="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />

                <Rectangle Width="40" Height="10"
                           Fill="LightGreen"
                           Stroke="Green"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <Rectangle Width="6" Height="2"
                           Fill="Brown" Margin="81,191,113,191" />
            </Grid>
        </Viewbox>
    </Grid>
</Window>